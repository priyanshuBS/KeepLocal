{
  "name": "keeplocal",
  "private": true,
  "version": "1.0.0",
  "description": "Convert anything. Upload nothing. A privacy-first, browser-local file converter.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "fflate": "^0.8.3",
    "marked": "^18.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "yaml": "^2.9.1"
  }
}
